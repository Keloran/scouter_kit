<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppActionBar" parent="android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/canvas</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
