FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libicu76 libssl3t64 zlib1g libstdc++6 \
        python3 python3-pil python3-cryptography xxd file procps \
    && rm -rf /var/lib/apt/lists/*
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 HOME=/tmp
