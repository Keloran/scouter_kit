        // ScouterKit: the payload of the master's last ESB frame other than an announcement (hex), and an
        // acknowledgement payload that replaces the response marker while it is set (hex, the arm-to-arm link
        // tests of g1v0).
        public string LastPayloadHex { get; private set; } = "";
        public string ResponsePayloadHex { get; set; } = "";
