            Mode = ModeSleep;
            UpdateIrq();
        }

        // A brown-out of the controller alone: its configuration is gone and bit0 says so (the firmware loads
        // it again); the observability counters stay.
        public void ControllerReset()
        {
            configWrites = 0;
            CommitWritten = false;
            EnableMask = 0;
            Mode = ModeSleep;
            pendingEvents |= EventControllerReset;
            UpdateIrq();
.
