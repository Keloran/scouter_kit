        public bool IrqAsserted { get; private set; }
        // 0x4408 writes 1 active, 2 sleep, 3 deep sleep (REG_WST 0x1BAC reads 0x01000000, 0x03000000, 0); events
        // are delivered only while active. The chip comes up in sleep (both arms read 0x03000000 unconfigured).
        public uint Mode { get; private set; }
.
180a
        // The controller's own wear classification (Awinic's in-ear / out-of-ear bits 8 and 7).
        public void Worn()
        {
            Queue(EventWorn);
        }

        public void Removed()
        {
            Queue(EventRemoved);
        }

        // Any 0x4410 value, delivered like a touch event.
        public void Event(uint bits)
        {
            Queue(bits);
        }

        // A controller that is not scanning (asleep, or not configured) senses nothing.
        private void Queue(uint bits)
        {
            if(!EventsArmed)
            {
                this.Log(LogLevel.Info, "G1TOUCH event 0x{0:X} not sensed: not scanning", bits);
                return;
            }
            queuedEvents.Add(bits);
            UpdateIrq();
        }

        private void UpdateIrq()
        {
            var active = (pendingEvents & (EnableMask | EventControllerReset)) != 0
                || (EventsArmed && queuedEvents.Count > 0 && (queuedEvents[0] & EnableMask) != 0);
            IrqAsserted = active;
            IRQ.Set(!active);
        }

