341a
        // The shortcuts of COMPARE[idx], after the event as on hardware.
        private void RunShorts(int idx)
        {
            if(shortClear[idx].Value)
            {
                ClearTimer();
            }
            if(shortStop[idx].Value)
            {
                StopTimer();
            }
        }

