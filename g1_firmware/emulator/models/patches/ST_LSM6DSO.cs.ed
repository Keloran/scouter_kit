        // -------------------- sampling, FIFO, wake-up, INT pins (project additions) --------------------

        private bool LatchedInterrupts => (tapCfg0.Value & 1) != 0;
        private bool InterruptsEnabled => (tapCfg2.Value & 0x80) != 0;
        private int Watermark => (int)(RegistersCollection.Read((long)Registers.FifoCtrl1) | ((RegistersCollection.Read((long)Registers.FifoCtrl2) & 1u) << 8));
        private bool FifoWatermarkReached => Watermark > 0 && fifo.Count >= Watermark;

        private void UpdateOdrTimer()
        {
            var hz = OdrHz(accelOutputDataRate.Value);
            if(hz <= 0)
            {
                odrTimer.Enabled = false;
                newSample = false;
                UpdateInterrupts();
                return;
            }
            odrTimer.Limit = (ulong)Math.Round(1000000.0 / hz);
            odrTimer.Value = 0;
            odrTimer.Enabled = true;
            havePrevious = false;
        }

        private static double OdrHz(ulong code)
        {
            switch(code)
            {
            case 1: return 12.5;
            case 2: return 26;
            case 3: return 52;
            case 4: return 104;
            case 5: return 208;
            case 6: return 416;
            case 7: return 833;
            case 8: return 1660;
            case 9: return 3330;
            case 10: return 6660;
            case 11: return 1.6;
            default: return 0;
            }
        }

        private void TakeSample()
        {
            var raw = new short[] { AccelRaw(AccelerationX), AccelRaw(AccelerationY), AccelRaw(AccelerationZ) };
            newSample = true;
            if(fifoMode.Value == 6 && (RegistersCollection.Read((long)Registers.FifoCtrl3) & 0x0F) != 0)
            {
                if(fifo.Count >= FifoCapacity)
                {
                    fifo.RemoveAt(0);
                    fifoOverrun = true;
                }
                var word = new byte[7];
                word[0] = 0x02 << 3;
                for(var i = 0; i < 3; i++)
                {
                    word[1 + 2 * i] = (byte)raw[i];
                    word[2 + 2 * i] = (byte)(raw[i] >> 8);
                }
                fifo.Add(word);
            }
            if(InterruptsEnabled && havePrevious)
            {
                var lsbMg = (wakeUpDur.Value & 0x10) != 0 ? FullScaleMg / 256.0 : FullScaleMg / 64.0;
                var threshold = (wakeUpThs.Value & 0x3F) * lsbMg;
                var axes = 0;
                for(var i = 0; i < 3; i++)
                {
                    var slopeMg = (raw[i] - previous[i]) / 2.0 * MgPerLsb;
                    if(Math.Abs(slopeMg) > threshold)
                    {
                        axes |= 4 >> i;
                    }
                }
                if(axes != 0)
                {
                    wakeUp = true;
                    wakeAxes = axes;
                }
                else if(!LatchedInterrupts)
                {
                    wakeUp = false;
                    wakeAxes = 0;
                }
            }
            previous = raw;
            havePrevious = true;
            UpdateInterrupts();
        }

        private uint FifoByte(int index)
        {
            if(fifo.Count == 0)
            {
                return 0;
            }
            var b = fifo[0][index];
            if(index == 6)
            {
                fifo.RemoveAt(0);
                UpdateInterrupts();
            }
            return b;
        }

        private void UpdateInterrupts()
        {
            if(int1Ctrl == null || md1Cfg == null || tapCfg2 == null)
            {
                return;
            }
            var wake = InterruptsEnabled && wakeUp;
            var level1 = ((int1Ctrl.Value & 1) != 0 && AccelerometerEnabled && newSample)
                         || ((int1Ctrl.Value & 0x08) != 0 && FifoWatermarkReached)
                         || ((md1Cfg.Value & 0x20) != 0 && wake);
            var level2 = ((int2Ctrl.Value & 1) != 0 && AccelerometerEnabled && newSample)
                         || ((int2Ctrl.Value & 0x08) != 0 && FifoWatermarkReached)
                         || ((md2Cfg.Value & 0x20) != 0 && wake);
            var low = activeLow != null && activeLow.Value;
            Int1.Set(level1 != low);
            Int2.Set(level2 != low);
        }

        private void ClearSampling()
        {
            odrTimer.Enabled = false;
            fifo.Clear();
            fifoOverrun = false;
            newSample = false;
            wakeUp = false;
            wakeAxes = 0;
            havePrevious = false;
            UpdateInterrupts();
        }

        private double MgPerLsb
        {
            get
            {
                switch(accelFullScale.Value)
                {
                case 0: return 0.061;
                case 1: return 0.488;
                case 2: return 0.122;
                default: return 0.244;
                }
            }
        }

        private double FullScaleMg
        {
            get
            {
                switch(accelFullScale.Value)
                {
                case 0: return 2000;
                case 1: return 16000;
                case 2: return 4000;
                default: return 8000;
                }
            }
