  "$defs": {
    "snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "view": {
          "enum": [
            "sites",
            "ai",
            "notifications",
            "stats"
          ]
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_paused": {
          "type": "boolean"
        },
        "rotation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "required": [
        "schema_version",
        "revision",
        "view",
        "page_id",
        "project",
        "rotation_paused",
        "rotation_ms"
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "enum": [
            "ai",
            "system"
          ]
        },
        "sample_unix_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "fresh",
            "stale",
            "unavailable"
          ]
        },
        "values": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "enum": [
                      "codex",
                      "claude"
                    ]
                  },
                  "window": {
                    "enum": [
                      "short",
                      "weekly",
                      "other"
                    ]
                  },
                  "used_percent": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reset_unix_ms": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "provider",
                  "window",
                  "used_percent",
                  "reset_unix_ms"
                ],
                "additionalProperties": false
              },
              "maxItems": 8
            },
            {
              "type": "object",
              "properties": {
                "cpu_percent": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "memory_used_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "memory_total_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "battery_percent": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "cpu_percent",
                "memory_used_bytes",
                "memory_total_bytes",
                "battery_percent"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "revision",
        "source",
        "sample_unix_ms",
        "age_ms",
        "status",
        "values"
      ],
      "additionalProperties": false
    },
    "arms": {
      "type": "object",
      "properties": {
        "left": {
          "type": "boolean"
        },
        "right": {
          "type": "boolean"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "laptop",
            "phone"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 16
        },
        "optional_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxItems": 16
        }
      },
      "required": [
        "role",
        "required_capabilities",
        "optional_capabilities"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "laptop",
            "phone"
          ]
        },
        "phase": {
          "enum": [
            "idle",
            "requesting",
            "yielding",
            "acquiring",
            "active",
            "recovering",
            "degraded"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "arms": {
          "type": "object",
          "properties": {
            "left": {
              "type": "boolean"
            },
            "right": {
              "type": "boolean"
            }
          },
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        "renderer_ready": {
          "type": "boolean"
        },
        "transfer": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ready_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "role",
        "phase",
        "eligible",
        "pinned",
        "arms",
        "renderer_ready",
        "transfer",
        "ready_epoch"
      ],
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "lid": {
          "enum": [
            "open",
            "closed",
            "absent",
            "unknown"
          ]
        },
        "awake": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "startup",
            "lid_closed",
            "suspend",
            "resume",
            "preference",
            "manual",
            "peer_lost",
            "acquire_failed",
            "partial_arms",
            "timeout",
            "stopped",
            "protocol_error"
          ]
        }
      },
      "required": [
        "eligible",
        "lid",
        "awake",
        "reason"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "target": {
          "enum": [
            "laptop",
            "phone"
          ]
        },
        "reason": {
          "enum": [
            "startup",
